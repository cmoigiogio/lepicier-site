---
import { Picture } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import { photos } from "../data/gallery";
import { site, reservationHref } from "../data/site";
---
<Layout bare>
  <!-- HERO — épuré : photo plein écran, logo centré, adresse, bouton Réserver en bas au centre -->
  <section class="relative isolate flex h-[100svh] min-h-[560px] flex-col items-center justify-center overflow-hidden text-center">
    <div class="absolute inset-0 -z-10">
      <Picture src={photos.salleLanternes.src} alt="" widths={[800, 1152]} sizes="100vw" layout="full-width" class="hero-zoom h-full w-full object-cover" priority />
      <div class="absolute inset-0 bg-night/30"></div>
      <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-night/70 to-transparent"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_35%,#07080f99_100%)]"></div>
    </div>

    <h1 class="sr-only">L’Épicier, speakeasy à Paris 3e</h1>
    <Logo class="text-[clamp(3.25rem,11vw,9rem)] drop-shadow-[0_8px_40px_rgba(0,0,0,.6)]" />
    <p class="mt-5 px-6 font-display text-lg text-cream drop-shadow-[0_2px_12px_rgba(0,0,0,.8)] sm:text-2xl">
      Le seul bar caché de Paris
      <span class="mt-1 block text-sm text-cream/75 italic sm:text-base" lang="en">The only hidden bar in Paris</span>
    </p>
    <div class="mt-8 flex flex-col items-center gap-3 text-cream/85">
      <span class="h-px w-12 bg-amber/70"></span>
      <p class="text-[11px] font-medium tracking-[0.42em] uppercase">{site.address.street}</p>
      <p class="text-[11px] font-medium tracking-[0.42em] uppercase">{site.address.postalCode} {site.address.city}</p>
    </div>

    <div class="absolute inset-x-0 bottom-10 flex flex-col items-center gap-3 sm:bottom-14">
      <a href={reservationHref} class="border border-cream/80 bg-night/20 px-10 py-4 font-display text-sm tracking-[0.35em] text-cream uppercase backdrop-blur-[2px] transition duration-300 hover:border-amber hover:bg-amber hover:text-night" aria-describedby="resa-note">Réserver<span class="tracking-normal text-amber" aria-hidden="true">*</span></a>
      <p id="resa-note" class="text-[11px] tracking-[0.2em] text-cream/75 uppercase"><span class="text-amber">*</span> à partir de 5 personnes</p>
    </div>
  </section>
</Layout>
