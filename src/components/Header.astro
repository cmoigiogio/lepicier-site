---
import Logo from "./Logo.astro";
import { reservationHref } from "../data/site";

const links = [
  { href: "/", label: "Accueil" },
  { href: "/carte", label: "La carte" },
  { href: "/galerie", label: "Galerie" },
  { href: "/infos-pratiques", label: "Infos pratiques" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300 data-[scrolled]:border-line/70 data-[scrolled]:bg-night/80 data-[scrolled]:backdrop-blur-md" data-header>
  <div class="mx-auto flex h-18 max-w-7xl items-center justify-between px-5 lg:px-8">
    <a href="/" class="text-2xl" aria-label="L’Épicier — accueil"><Logo /></a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Navigation principale">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={path === l.href ? "page" : undefined}
          class="relative text-sm tracking-wide text-cream/80 transition hover:text-cream aria-[current=page]:text-amber after:absolute after:-bottom-1.5 after:left-0 after:h-px after:w-0 after:bg-amber after:transition-all hover:after:w-full aria-[current=page]:after:w-full"
        >{l.label}</a>
      ))}
      <a href={reservationHref} class="btn-primary !px-5 !py-2.5">Réserver</a>
    </nav>

    <button type="button" class="md:hidden -mr-2 p-2 text-cream" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h10" data-icon-open />
        <path d="M6 6l12 12M18 6L6 18" class="hidden" data-icon-close />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-line bg-night/95 backdrop-blur-md md:hidden" aria-label="Navigation mobile" data-mobile-nav>
    <ul class="flex flex-col px-5 py-4">
      {links.map((l) => (
        <li><a href={l.href} aria-current={path === l.href ? "page" : undefined} class="block py-3 font-display text-2xl text-cream aria-[current=page]:text-amber">{l.label}</a></li>
      ))}
      <li class="pt-4"><a href={reservationHref} class="btn-primary w-full">Réserver une table</a></li>
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]")!;
  const onScroll = () => header.toggleAttribute("data-scrolled", window.scrollY > 24);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]")!;
  const nav = document.querySelector<HTMLElement>("[data-mobile-nav]")!;
  toggle.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
    nav.classList.toggle("hidden", !open);
    toggle.querySelector("[data-icon-open]")!.classList.toggle("hidden", open);
    toggle.querySelector("[data-icon-close]")!.classList.toggle("hidden", !open);
    header.toggleAttribute("data-scrolled", open || window.scrollY > 24);
  });
</script>
