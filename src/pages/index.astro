---
import { Picture } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Hours from "../components/Hours.astro";
import MapEmbed from "../components/MapEmbed.astro";
import { photos } from "../data/gallery";
import { menu } from "../data/menu";
import { site, reservationHref } from "../data/site";

const signatures = menu.find((s) => s.id === "signatures")!.groups[0]!;
const preview = [photos.salleLanternes, photos.cocktailsTiki, photos.epicerie, photos.lanternesNuit, photos.murRouge, photos.alcove];
---
<Layout>
  <!-- HERO -->
  <section class="relative isolate overflow-hidden pt-28 pb-20 md:pt-36 lg:min-h-[100dvh] lg:pb-28">
    <div class="absolute inset-0 -z-10">
      <Picture src={photos.lanternesNuit.src} alt="" widths={[800, 1400, 2000]} sizes="100vw" layout="full-width" class="h-full w-full object-cover opacity-25 blur-sm" priority />
      <div class="absolute inset-0 bg-gradient-to-b from-night/70 via-night/85 to-night"></div>
      <div class="absolute -top-40 left-1/2 h-[36rem] w-[36rem] -translate-x-1/2 rounded-full bg-amber/15 blur-3xl animate-flicker"></div>
    </div>

    <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 lg:grid-cols-[1.1fr_0.9fr] lg:px-8">
      <div>
        <p class="eyebrow">{site.tagline}</p>
        <h1 class="mt-6 font-display text-5xl leading-[1.02] font-medium tracking-tight text-balance sm:text-6xl lg:text-7xl xl:text-8xl">
          Poussez la porte <em class="font-normal text-amber not-italic sm:italic">de l’épicerie.</em>
        </h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-sand text-pretty">
          Derrière les rayons, un bar caché sous les lanternes&nbsp;: cocktails de création aux accents libanais, petites assiettes à partager et longues nuits douces.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href={reservationHref} class="btn-primary">Réserver une table</a>
          <a href="/carte" class="btn-ghost">Découvrir la carte</a>
        </div>
        <dl class="mt-14 grid max-w-lg grid-cols-2 gap-6 border-t border-line pt-6 text-sm">
          <div>
            <dt class="text-mute">Adresse</dt>
            <dd class="mt-1 text-cream/90">{site.address.street}<br />{site.address.postalCode} {site.address.city}</dd>
          </div>
          <div>
            <dt class="text-mute">Horaires</dt>
            <dd class="mt-1 text-cream/90">Mar – Jeu · 19 h – 1 h<br />Ven – Sam · 18 h – 2 h</dd>
          </div>
        </dl>
      </div>

      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <div class="absolute -inset-6 -z-10 rounded-[2.5rem] bg-gradient-to-br from-lantern/30 via-lapis/20 to-amber/30 blur-2xl"></div>
        <div class="overflow-hidden rounded-[2rem] border border-cream/10 shadow-2xl shadow-black/60">
          <Picture src={photos.devanture.src} alt={photos.devanture.alt} widths={[480, 720, 1086]} sizes="(min-width: 1024px) 40vw, 90vw" class="aspect-[3/4] w-full object-cover" priority />
        </div>
        <div class="absolute -bottom-8 -left-6 hidden w-40 overflow-hidden rounded-2xl border-4 border-night shadow-xl sm:block lg:-left-12 lg:w-48">
          <Picture src={photos.epicerie.src} alt={photos.epicerie.alt} widths={[240, 400]} sizes="12rem" class="aspect-square w-full object-cover" />
        </div>
        <p class="absolute -right-2 -bottom-4 rotate-[-4deg] rounded-full bg-lantern px-4 py-2 text-xs font-semibold tracking-widest text-cream uppercase shadow-lg">Entrée par l’épicerie</p>
      </div>
    </div>
  </section>

  <!-- EXPÉRIENCE -->
  <section class="relative border-y border-line bg-ink py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="reveal max-w-2xl">
        <p class="eyebrow">L’expérience</p>
        <h2 class="mt-4 font-display text-4xl leading-tight sm:text-5xl text-balance">Une épicerie en façade, un bar caché derrière.</h2>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {[
          { n: "01", t: "Cocktails de création", d: "Arak, rose, basilic, lavande, gingembre : cinq signatures, toutes disponibles sans alcool.", c: "from-amber/25" },
          { n: "02", t: "Petites assiettes", d: "Houmous, caviar d’aubergine, rillettes du chef, baklawa et guimauve à la rose, à partager.", c: "from-jade/25" },
          { n: "03", t: "Privatisation", d: "Pour vos soirées privées, le bar se privatise sur demande. Écrivez-nous.", c: "from-lantern/25" },
        ].map((f) => (
          <article class={`reveal group relative overflow-hidden rounded-2xl border border-line bg-gradient-to-b ${f.c} to-panel/40 p-8 transition duration-500 hover:-translate-y-1 hover:border-amber/40`}>
            <span class="font-display text-5xl text-cream/15 transition group-hover:text-amber/40">{f.n}</span>
            <h3 class="mt-6 font-display text-2xl">{f.t}</h3>
            <p class="mt-3 leading-relaxed text-sand">{f.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SIGNATURES -->
  <section class="relative overflow-hidden py-24 lg:py-32">
    <div class="mx-auto grid max-w-7xl items-center gap-16 px-5 lg:grid-cols-2 lg:px-8">
      <div class="reveal relative order-2 lg:order-1">
        <div class="grid grid-cols-2 gap-4">
          <Picture src={photos.cocktailsTiki.src} alt={photos.cocktailsTiki.alt} widths={[400, 700]} sizes="(min-width: 1024px) 22vw, 45vw" class="aspect-[3/4] w-full rounded-2xl object-cover" />
          <Picture src={photos.lampeOrientale.src} alt={photos.lampeOrientale.alt} widths={[400, 700]} sizes="(min-width: 1024px) 22vw, 45vw" class="mt-12 aspect-[3/4] w-full rounded-2xl object-cover" />
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <p class="eyebrow">Signatures · {signatures.price} €</p>
        <h2 class="mt-4 font-display text-4xl sm:text-5xl">Cocktails de création</h2>
        <p class="mt-3 text-sm text-mute">Disponibles sans alcool</p>
        <ul class="mt-10 divide-y divide-line border-y border-line">
          {signatures.items.map((c) => (
            <li class="reveal py-5">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-display text-2xl">{c.name}</h3>
                {c.tag && <span class="hidden text-right text-xs italic text-sand sm:block">{c.tag}</span>}
              </div>
              <p class="mt-1 text-sm text-sand">{c.fr}</p>
            </li>
          ))}
        </ul>
        <a href="/carte" class="mt-10 inline-flex items-center gap-2 text-amber transition hover:gap-3 hover:text-amber-soft">Voir toute la carte <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- GALERIE -->
  <section class="border-t border-line bg-ink py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow">Galerie</p>
          <h2 class="mt-4 font-display text-4xl sm:text-5xl">Sous les lanternes</h2>
        </div>
        <a href="/galerie" class="btn-ghost">Toutes les photos</a>
      </div>
      <div class="mt-12 grid auto-rows-[12rem] grid-cols-2 gap-3 md:auto-rows-[15rem] md:grid-cols-4">
        {preview.map((p, i) => (
          <a href="/galerie" class:list={["reveal group relative overflow-hidden rounded-xl", ["col-span-2 md:row-span-2", "md:row-span-2", "", "", "md:col-span-2", "col-span-2"][i]]}>
            <Picture src={p.src} alt={p.alt} widths={[400, 800, 1200]} sizes={i === 0 || i >= 4 ? "(min-width: 768px) 50vw, 100vw" : "(min-width: 768px) 25vw, 50vw"} class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />
            <span class="absolute inset-0 bg-gradient-to-t from-night/60 to-transparent opacity-0 transition group-hover:opacity-100"></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- INFOS -->
  <section class="py-24 lg:py-32">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-2 lg:px-8">
      <div class="reveal">
        <p class="eyebrow">Infos pratiques</p>
        <h2 class="mt-4 font-display text-4xl sm:text-5xl">Nous trouver</h2>
        <Hours class="mt-10 border-y border-line" />
        <div class="mt-10 flex flex-wrap gap-4">
          <a href={reservationHref} class="btn-primary">Réserver par e-mail</a>
          <a href={site.instagram.url} target="_blank" rel="noopener" class="btn-ghost">Instagram</a>
        </div>
      </div>
      <div class="reveal min-h-80">
        <MapEmbed />
      </div>
    </div>
  </section>
</Layout>
