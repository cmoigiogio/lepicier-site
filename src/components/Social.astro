---
import { site } from "../data/site";
interface Props { class?: string; size?: "sm" | "lg" }
const { class: cls = "", size = "sm" } = Astro.props;
const box = size === "lg" ? "h-12 w-12" : "h-10 w-10";
const icon = size === "lg" ? "h-5 w-5" : "h-[18px] w-[18px]";
---
<ul class:list={["flex items-center gap-3", cls]} aria-label="Réseaux sociaux">
  <li>
    <a href={site.instagram.url} target="_blank" rel="noopener" aria-label={`Instagram @${site.instagram.handle}`} title="Instagram"
      class={`flex ${box} items-center justify-center rounded-full border border-cream/20 text-cream/85 transition hover:border-amber hover:text-amber`}>
      <svg viewBox="0 0 24 24" class={icon} fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
    </a>
  </li>
  <li>
    <a href={site.tiktok.url} target="_blank" rel="noopener" aria-label={`TikTok @${site.tiktok.handle}`} title="TikTok"
      class={`flex ${box} items-center justify-center rounded-full border border-cream/20 text-cream/85 transition hover:border-amber hover:text-amber`}>
      <svg viewBox="0 0 24 24" class={icon} fill="currentColor" aria-hidden="true"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.59 2.59 0 0 1-2.59-2.59 2.59 2.59 0 0 1 3.37-2.47V9.68a5.68 5.68 0 0 0-.78-.05A5.67 5.67 0 0 0 4.2 15.3a5.67 5.67 0 0 0 5.66 5.66 5.67 5.67 0 0 0 5.67-5.66V9.01a7.34 7.34 0 0 0 4.27 1.36V7.29a4.28 4.28 0 0 1-3.2-1.47z"/></svg>
    </a>
  </li>
</ul>
