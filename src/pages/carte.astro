---
import { Picture } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { menu } from "../data/menu";
import billets from "../assets/photos/billets-liban.jpg";

const signatures = menu.find((s) => s.id === "signatures")!;
const classiques = menu.find((s) => s.id === "incontournables")!;
const others = menu.filter((s) => s.id !== "signatures" && s.id !== "incontournables");
const pad = (n: number) => String(n + 1).padStart(2, "0");
---
<Layout title="La carte" description="La carte de L’Épicier : cocktails de création, grands classiques, mocktails, spiritueux et petites assiettes à partager. Paris 3e.">
  <!-- Fond : anciens billets libanais, quasi transparents, fixes derrière toute la carte -->
  <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
    <Picture src={billets} alt="" widths={[798]} sizes="100vw" class="h-full w-full object-cover opacity-[0.22] sepia-[.35]" loading="eager" />
    
  </div>

  <header class="pt-36 pb-14 text-center">
    <p class="eyebrow">Menu · Drinks & food</p>
    <h1 class="mt-5 font-display text-6xl font-medium sm:text-8xl">La carte</h1>
    <p class="mx-auto mt-5 max-w-xl text-sand">Découvrez notre menu · <span class="italic">Discover our menu</span></p>
    <div class="rule mx-auto mt-8 max-w-xs" aria-hidden="true">◆</div>
    <a
      href="/menu-lepicier.pdf"
      download="carte-lepicier.pdf"
      type="application/pdf"
      class="btn-ghost mt-8 px-5 py-2 text-[0.7rem] whitespace-nowrap tracking-[0.2em] uppercase"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14" /></svg>
      Télécharger la carte
    </a>
  </header>

  <!-- Section nav -->
  <nav class="sticky top-18 z-40 border-y border-line/70 bg-night/70 backdrop-blur-md" aria-label="Sections de la carte">
    <ul class="mx-auto flex max-w-6xl gap-1 overflow-x-auto px-5 py-3 [scrollbar-width:none] lg:justify-center lg:px-8">
      {menu.map((s) => (
        <li><a href={`#${s.id}`} class="block whitespace-nowrap rounded-full px-4 py-2 text-sm text-cream/75 transition hover:bg-panel hover:text-amber" data-menu-link>{s.title}</a></li>
      ))}
    </ul>
  </nav>

  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <!-- SIGNATURES : la vedette de la carte -->
    <section id="signatures" class="scroll-mt-36" data-menu-section>
      <div class="relative border border-amber/40 p-1.5">
        <div class="border border-amber/25 px-5 py-14 sm:px-12">
          <header class="reveal text-center">
            <p class="eyebrow">{signatures.titleEn}</p>
            <h2 class="mt-3 font-display text-4xl font-bold text-amber sm:text-6xl">{signatures.title}</h2>
            <p class="mt-5 inline-block rounded-full border border-jade/40 bg-jade/10 px-4 py-1.5 text-xs tracking-wide text-cream/90">{signatures.intro}</p>
            <p class="mt-6 font-display text-3xl text-amber-soft">{signatures.groups[0]!.price}<span class="text-lg"> €</span></p>
          </header>

          <ol class="mt-14 grid gap-x-12 gap-y-12 md:grid-cols-2">
            {signatures.groups[0]!.items.map((c, i) => (
              <li class:list={["reveal group relative", i === signatures.groups[0]!.items.length - 1 && signatures.groups[0]!.items.length % 2 === 1 && "md:col-span-2 md:mx-auto md:max-w-md md:text-center"]}>
                <span class="font-display text-sm text-amber/70">{pad(i)}</span>
                <h3 class="mt-1 font-display text-3xl leading-tight font-extrabold tracking-wide text-cream uppercase [text-shadow:0_2px_18px_#07080f] sm:text-[2.1rem]">
                  {c.name}{c.allergen && <sup class="ml-1 text-base text-amber" title="Allergène">*</sup>}
                </h3>
                {c.tag && <p class="mt-1 font-display italic text-amber-soft">{c.tag}</p>}
                <p class="mt-3 text-[0.95rem] leading-relaxed text-cream/85">{c.fr}</p>
                <p class="mt-1 text-sm leading-relaxed text-sand/75 italic">{c.en}</p>
                <span class:list={["mt-5 block h-px w-16 bg-gradient-to-r from-amber/60 to-transparent", i === signatures.groups[0]!.items.length - 1 && signatures.groups[0]!.items.length % 2 === 1 && "md:mx-auto"]}></span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- LES INCONTOURNABLES -->
    <section id="incontournables" class="scroll-mt-36 pt-28" data-menu-section>
      <header class="reveal flex flex-wrap items-end justify-between gap-4 border-b border-amber/30 pb-6">
        <div>
          <p class="eyebrow">{classiques.titleEn}</p>
          <h2 class="mt-3 font-display text-4xl font-bold sm:text-5xl">{classiques.title}</h2>
        </div>
        <p class="font-display text-3xl text-amber-soft">{classiques.groups[0]!.price}<span class="text-lg"> €</span></p>
      </header>
      <ul class="mt-10 grid gap-x-12 gap-y-9 md:grid-cols-2">
        {classiques.groups[0]!.items.map((c) => (
          <li class="reveal">
            <div class="flex items-baseline gap-3">
              <h3 class="font-display text-2xl font-extrabold tracking-wide text-cream uppercase [text-shadow:0_2px_14px_#07080f]">
                {c.name}{c.allergen && <sup class="ml-0.5 text-sm text-amber" title="Allergène">*</sup>}
              </h3>
              {c.tag && <span class="rounded-full border border-cream/15 px-2 py-0.5 text-[10px] tracking-[0.18em] text-sand uppercase">{c.tag}</span>}
            </div>
            <p class="mt-2 text-sm leading-relaxed text-cream/80">{c.fr}</p>
            <p class="mt-0.5 text-sm leading-relaxed text-sand/75 italic">{c.en}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- LE RESTE DE LA CARTE -->
    {others.map((section) => (
      <section id={section.id} class="scroll-mt-36 pt-28" data-menu-section>
        <header class="reveal text-center">
          <p class="eyebrow">{section.titleEn}</p>
          <h2 class="mt-3 font-display text-4xl font-bold sm:text-5xl">{section.title}</h2>
          <div class="rule mx-auto mt-6 max-w-xs" aria-hidden="true">◆</div>
        </header>
        <div class:list={["mt-12 grid gap-x-14 gap-y-12", section.groups.length > 1 && "md:grid-cols-2"]}>
          {section.groups.map((g) => (
            <div class="reveal rounded-2xl border border-line/70 bg-night/55 p-6 backdrop-blur-[2px] sm:p-8">
              <div class="mb-5 flex items-baseline justify-between gap-4 border-b border-amber/30 pb-3">
                <h3 class="font-display text-2xl font-bold">
                  {g.title}
                  {g.titleEn && <span class="ml-2 font-sans text-xs font-normal tracking-wide text-mute italic">{g.titleEn}</span>}
                </h3>
                {g.price && <span class="font-display text-2xl text-amber-soft">{g.price}<span class="text-base"> €</span></span>}
              </div>
              <ul class="space-y-4">
                {g.items.map((it) => (
                  <li>
                    <div class="flex items-baseline gap-3">
                      <span class="font-semibold tracking-wide text-cream">{it.name}{it.allergen && <sup class="ml-0.5 text-amber" title="Allergène">*</sup>}</span>
                      <span class="mx-1 flex-1 translate-y-[-3px] border-b border-dotted border-line"></span>
                      {it.desc && <span class="text-sm text-sand">{it.desc}</span>}
                      {it.price && <span class="font-display text-lg text-amber-soft">{it.price}</span>}
                    </div>
                    {it.fr && <p class="mt-1 text-sm leading-relaxed text-sand">{it.fr}</p>}
                    {it.en && <p class="mt-0.5 text-sm leading-relaxed text-sand/75 italic">{it.en}</p>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ))}

    <footer class="mt-20 border-t border-line pt-8 text-center">
      <p class="text-xs text-mute">
        Prix en € TTC · <span class="text-amber">*</span> Allergène — renseignez-vous auprès de l’équipe · L’abus d’alcool est dangereux pour la santé.
      </p>
    </footer>
  </div>
</Layout>

<script>
  // Highlight the section currently in view in the sticky menu nav.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-menu-link]")];
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((l) => {
          const on = l.hash === `#${e.target.id}`;
          l.classList.toggle("bg-panel", on);
          l.classList.toggle("text-amber", on);
          if (on) l.scrollIntoView({ block: "nearest", inline: "center", behavior: "smooth" });
        });
      }
    },
    { rootMargin: "-40% 0px -55% 0px" },
  );
  document.querySelectorAll("[data-menu-section]").forEach((s) => io.observe(s));
</script>
