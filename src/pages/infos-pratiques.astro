---
import { Picture } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Hours from "../components/Hours.astro";
import MapEmbed from "../components/MapEmbed.astro";
import Social from "../components/Social.astro";
import { photos } from "../data/gallery";
import { site, reservationHref, directionsUrl } from "../data/site";
---
<Layout title="Infos pratiques" description="Adresse, horaires, réservation et privatisation de L’Épicier, 24 rue Notre-Dame-de-Nazareth, Paris 3e.">
  <section class="pt-36 pb-16">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <p class="eyebrow">Infos pratiques</p>
      <h1 class="mt-5 font-display text-5xl sm:text-7xl">Nos infos</h1>
    </div>
  </section>

  <section class="pb-24">
    <div class="mx-auto grid max-w-7xl gap-6 px-5 lg:grid-cols-3 lg:px-8">
      <article class="reveal rounded-2xl border border-line bg-panel/60 p-8">
        <p class="eyebrow">Adresse</p>
        <address class="mt-5 font-display text-2xl not-italic leading-snug">{site.address.street}<br /><span class="text-sand">{site.address.postalCode} {site.address.city}</span></address>
        <a href={directionsUrl} target="_blank" rel="noopener" class="mt-6 inline-flex items-center gap-2 text-amber hover:text-amber-soft">Itinéraire <span aria-hidden="true">→</span></a>
      </article>

      <article class="reveal rounded-2xl border border-line bg-panel/60 p-8">
        <p class="eyebrow">Contact & réservation</p>
        <a href={reservationHref} class="mt-5 block font-display text-2xl break-all text-cream hover:text-amber">{site.email}</a>
        <p class="mt-3 text-sm text-sand">Réservations et demandes de privatisation par e-mail.</p>
        <Social class="mt-6" size="lg" />
      </article>

      <article class="reveal overflow-hidden rounded-2xl border border-line">
        <Picture src={photos.devanture.src} alt={photos.devanture.alt} widths={[400, 700]} sizes="(min-width: 1024px) 33vw, 100vw" class="h-full max-h-80 w-full object-cover lg:max-h-none" />
      </article>

      <article class="reveal rounded-2xl border border-line bg-panel/60 p-8 lg:col-span-1">
        <p class="eyebrow">Heures d’ouverture</p>
        <Hours class="mt-4" />
      </article>

      <div class="reveal min-h-96 lg:col-span-2">
        <MapEmbed />
      </div>
    </div>
  </section>
</Layout>
