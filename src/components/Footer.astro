---
import Logo from "./Logo.astro";
import Social from "./Social.astro";
import { site, directionsUrl } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="relative border-t border-line bg-ink">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 md:grid-cols-4 lg:px-8">
    <div class="md:col-span-2">
      <a href="/" class="text-3xl"><Logo /></a>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-sand">{site.tagline}. Poussez la porte de l’épicerie.</p>
      <Social class="mt-6" />
    </div>
    <div>
      <h2 class="eyebrow">Adresse</h2>
      <address class="mt-4 text-sm not-italic leading-relaxed text-cream/85">
        {site.address.street}<br />{site.address.postalCode} {site.address.city}
      </address>
      <a href={directionsUrl} target="_blank" rel="noopener" class="mt-3 inline-block text-sm text-amber hover:text-amber-soft">Itinéraire →</a>
    </div>
    <div>
      <h2 class="eyebrow">Horaires</h2>
      <ul class="mt-4 space-y-2 text-sm text-cream/85">
        {site.hours.map((h) => <li>{h.days}<br /><span class="text-sand">{h.hours}</span></li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-5 py-6 text-xs text-mute md:flex-row md:items-center md:justify-between lg:px-8">
      <p>© {year} L’Épicier · L’abus d’alcool est dangereux pour la santé, à consommer avec modération.</p>
      <p class="shrink-0">Site imaginé et réalisé par <span class="font-semibold tracking-wide text-sand">BlueChip Technologies</span></p>
    </div>
  </div>
</footer>
